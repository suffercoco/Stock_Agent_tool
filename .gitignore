# Python caches
.venv/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Distribution / packaging
build/
dist/
*.egg-info/

# OS / editor cruft
.DS_Store

# Secrets / local env
.env
.env.*

# Local data / scratch files, never committed
*.log
*.txt
dashboard.html
test.py

# SQLite databases (incl. write-ahead log sidecars)
*.db
*.sqlite
*.sqlite3
*.db-wal
*.db-shm
